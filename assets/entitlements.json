{
  "version": "1.2.0",
  "updated_at": "2026-07-31",
  "doctrine": "Open = spec, docs, pilot, Lab preview only. Library, Builder, and Marketplace require governed install. Local operator override is Lab hostname only \u2014 not payment.",
  "tiers": {
    "anonymous": {
      "label": "Visitor",
      "public": true
    },
    "free": {
      "label": "Open",
      "public": true,
      "includes": [
        "marketing_site",
        "spec_docs",
        "pilot",
        "platform_lab_preview"
      ]
    },
    "pro": {
      "label": "Governed / operator",
      "public": false,
      "includes": [
        "everything_in_open",
        "platform_lab_full",
        "platform_marketplace",
        "platform_builder",
        "create_workflow",
        "install_actions",
        "runtime_status_when_wired"
      ],
      "billing": "scoped_install_after_review",
      "contact": "mailto:hello@workflowware.org?subject=Workflowware%20governed%20install",
      "local_override_only": true
    }
  },
  "routes": {
    "index.html": {
      "min_tier": "anonymous"
    },
    "spec.html": {
      "min_tier": "anonymous"
    },
    "docs.html": {
      "min_tier": "anonymous"
    },
    "library.html": {
      "min_tier": "pro"
    },
    "pilot.html": {
      "min_tier": "anonymous"
    },
    "pricing.html": {
      "min_tier": "anonymous"
    },
    "app.html": {
      "min_tier": "free",
      "mode": "preview_on_free"
    },
    "app-library.html": {
      "min_tier": "pro"
    },
    "app-marketplace.html": {
      "min_tier": "pro"
    },
    "app-builder.html": {
      "min_tier": "pro"
    }
  },
  "features": {
    "lab_preview": {
      "min_tier": "free"
    },
    "lab_full": {
      "min_tier": "pro"
    },
    "library_browse": {
      "min_tier": "pro"
    },
    "marketplace": {
      "min_tier": "pro"
    },
    "builder": {
      "min_tier": "pro"
    },
    "create_workflow": {
      "min_tier": "pro"
    },
    "install_actions": {
      "min_tier": "pro"
    },
    "open_command_center": {
      "min_tier": "pro"
    },
    "public_library": {
      "min_tier": "pro"
    }
  },
  "runtime_hook": {
    "status": "not_wired",
    "who_endpoint": "/v1/who",
    "entitlement_endpoint": "/v1/entitlements",
    "note": "Runtime who/may replaces localStorage. Until then, public stays Open; governed routes stay closed except local operator override."
  }
}
