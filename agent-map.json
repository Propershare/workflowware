{
  "name": "Workflowware",
  "version": "0.6.3",
  "purpose": "A platform for discovering, installing, verifying, running, and handing off governed AI workflow packages.",
  "start_here": [
    "AGENTS.md",
    "agent-map.json",
    "index.html",
    "library.html",
    "pilot.html",
    "docs.html",
    "spec.html"
  ],
  "routes": {
    "/": {
      "file": "index.html",
      "role": "public_marketing_site",
      "primary_actions": [
        "open_pilot",
        "read_spec",
        "open_platform"
      ],
      "status": "classic_restored"
    },
    "/library.html": {
      "file": "library.html",
      "role": "platform_package_library",
      "min_tier": "pro",
      "paywall": true,
      "primary_actions": [
        "open_pilot",
        "download_pilot_zip",
        "request_scoped_build"
      ],
      "status": "active_build",
      "packages": [
        "missed-lead-recovery",
        "chronology-research-kit",
        "kemetic-mathematics-teaching-kit"
      ]
    },
    "/pilot.html": {
      "file": "pilot.html",
      "role": "launch_lab",
      "primary_actions": [
        "run_workflow",
        "inspect_output",
        "review_handoff"
      ],
      "status": "existing"
    },
    "/docs.html": {
      "file": "docs.html",
      "role": "documentation",
      "primary_actions": [
        "read_guides",
        "inspect_examples",
        "find_api_reference"
      ],
      "status": "existing"
    },
    "/spec.html": {
      "file": "spec.html",
      "role": "workflowware_specification",
      "primary_actions": [
        "read_contract",
        "inspect_package_anatomy",
        "understand_governance"
      ],
      "status": "existing"
    },
    "/app.html": {
      "file": "app.html",
      "role": "platform_lab",
      "status": "active_build",
      "min_tier": "free"
    },
    "/app-library.html": {
      "file": "app-library.html",
      "role": "redirect_to_library",
      "status": "redirect",
      "redirect": "library.html"
    },
    "/app-marketplace.html": {
      "file": "app-marketplace.html",
      "role": "platform_marketplace",
      "status": "active_build",
      "min_tier": "pro",
      "paywall": true
    },
    "/app-builder.html": {
      "file": "app-builder.html",
      "role": "platform_builder",
      "status": "active_build",
      "min_tier": "pro",
      "paywall": true
    },
    "/pricing.html": {
      "file": "pricing.html",
      "role": "access_truth",
      "primary_actions": [
        "open_pilot",
        "email_governed_install"
      ],
      "status": "active"
    }
  },
  "core_entities": {
    "package": {
      "definition": "A portable operating unit for one job.",
      "required_parts": [
        "job",
        "instructions",
        "rules",
        "approvals",
        "evals",
        "evidence",
        "handoff"
      ]
    },
    "agent": {
      "definition": "An execution role operating inside package constraints.",
      "must_know": [
        "allowed_tools",
        "prohibited_actions",
        "approval_points",
        "success_condition"
      ]
    },
    "eval": {
      "definition": "A declared test producing evidence about package behavior."
    },
    "handoff": {
      "definition": "The structured transfer of output, evidence, and unresolved items to a human or another agent."
    }
  },
  "navigation_rules": [
    "Prefer stable semantic labels over decorative text.",
    "Every important action must be represented by a link, button, form control, or documented endpoint.",
    "Do not require visual inference to understand page purpose.",
    "Use descriptive ids, classes, headings, aria-labels, and link text.",
    "Expose page purpose and available actions near the top of each document.",
    "Keep route names and entity names consistent across UI, docs, manifests, and code.",
    "Never hide required controls behind hover-only behavior.",
    "All agent-triggered mutations require an explicit approval or policy check."
  ],
  "agent_contract": {
    "read_order": [
      "AGENTS.md",
      "agent-map.json",
      "page source",
      "related docs"
    ],
    "before_action": [
      "identify_route",
      "identify_entity",
      "identify_allowed_action",
      "check_approval_requirement"
    ],
    "after_action": [
      "record_result",
      "record_evidence",
      "record_errors",
      "prepare_handoff"
    ],
    "truth_rule": "Never claim a page, workflow, package, metric, or capability is live unless the repository and runtime evidence support that claim."
  },
  "design_system": {
    "public_site": "classic_lime_sora",
    "platform_shell": "platform-classic.css",
    "contact_sheet": "visuals/assets-inbox/reference-platform-contact-sheet.png",
    "dense_dashboard_art": "parked_for_tehuti_lab_control"
  },
  "entitlements": {
    "map": "assets/entitlements.json",
    "gate": "assets/ww-entitlements.js",
    "open": [
      "marketing",
      "spec",
      "docs",
      "pilot",
      "lab_preview"
    ],
    "governed": [
      "library",
      "builder",
      "marketplace",
      "lab_full",
      "install_actions"
    ],
    "local_operator_override": "127.0.0.1/localhost only",
    "runtime_hook": "not_wired"
  }
}
