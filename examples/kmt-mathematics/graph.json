{
  "package": "kmt-mathematics",
  "version": "0.1.1",
  "job": "Multiply two integers by Egyptian doubling, verify by independent recomputation, audit the procedure, and hand off.",
  "example": "57 x 23 = 1311",
  "nodes": [
    {
      "id": "n_count",
      "kind": "start",
      "title": "Count: state 57 x 23",
      "model": "qwen3.8:27b",
      "produces": {
        "multiplicand": 57,
        "multiplier": 23
      }
    },
    {
      "id": "n_double",
      "kind": "draft",
      "title": "Calculate: build doubling table",
      "produces": {
        "doubling_table": [
          57,
          114,
          228,
          456,
          912
        ]
      }
    },
    {
      "id": "n_select",
      "kind": "draft",
      "title": "Calculate: select rows summing to 23",
      "produces": {
        "selected_rows": [
          912,
          228,
          114,
          57
        ]
      }
    },
    {
      "id": "n_sum",
      "kind": "draft",
      "title": "Calculate: sum the selected rows",
      "produces": {
        "result": 1311
      }
    },
    {
      "id": "n_verify_table",
      "kind": "verify",
      "title": "Inspect: verify the doubling table",
      "check": {
        "method": "doubling_table_valid",
        "args": {
          "table": "doubling_table"
        }
      },
      "model": "deepseek"
    },
    {
      "id": "n_verify_product",
      "kind": "verify",
      "title": "Inspect: verify the product by reverse division",
      "check": {
        "method": "reverse_division",
        "args": {
          "multiplicand": "multiplicand",
          "multiplier": "multiplier",
          "product": "result"
        }
      },
      "repair": "n_repair",
      "model": "deepseek"
    },
    {
      "id": "n_repair",
      "kind": "repair",
      "title": "Correct: re-derive and re-select",
      "produces": {
        "corrected_result": 1311
      }
    },
    {
      "id": "n_audit",
      "kind": "audit",
      "title": "Audit: procedural correctness + evidence",
      "require": [
        "doubling_table",
        "selected_rows",
        "result"
      ],
      "model": "claude"
    },
    {
      "id": "n_handoff",
      "kind": "handoff",
      "title": "Record/teach: record method + result, hand off"
    }
  ],
  "edges": [
    {
      "from": "n_count",
      "to": "n_double"
    },
    {
      "from": "n_double",
      "to": "n_select"
    },
    {
      "from": "n_select",
      "to": "n_sum"
    },
    {
      "from": "n_sum",
      "to": "n_verify_table"
    },
    {
      "from": "n_verify_table",
      "to": "n_verify_product"
    },
    {
      "from": "n_verify_product",
      "to": "n_audit"
    },
    {
      "from": "n_audit",
      "to": "n_handoff"
    }
  ]
}